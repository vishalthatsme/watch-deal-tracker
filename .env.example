# Optional overrides. Configuration defaults live in config/default.yaml.
WATCH_TRACKER_CONFIG=config/default.yaml
WATCH_TRACKER_TIMEZONE=America/Los_Angeles
WATCH_TRACKER_DATABASE_URL=sqlite:///data/database/watch_market.sqlite
WATCH_TRACKER_LOG_LEVEL=INFO

WATCH_TRACKER_USER_AGENT=watch-deal-tracker/0.1 (+local research tool)

# Reddit requires explicit approval and registered OAuth access.
WATCH_TRACKER_REDDIT_ENABLED=true
WATCH_TRACKER_REDDIT_ACCESS_APPROVED=false
WATCH_TRACKER_REDDIT_DELETION_CONTRACT_VERIFIED=false
WATCH_TRACKER_REDDIT_CLIENT_ID=
WATCH_TRACKER_REDDIT_CLIENT_SECRET=
WATCH_TRACKER_REDDIT_USERNAME=

# Chrono24 automation/database use requires permission. This release accepts a
# local licensed/authorized JSONL feed and does not scrape Chrono24 pages.
WATCH_TRACKER_CHRONO24_ENABLED=false
WATCH_TRACKER_CHRONO24_ACCESS_AUTHORIZED=false
WATCH_TRACKER_CHRONO24_FEED_PATH=
